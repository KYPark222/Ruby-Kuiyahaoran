<main class="simulator-shell">
  <header class="simulator-header">
    <div class="brand-lockup">
      <span class="brand-mark" aria-hidden="true">玉</span>
      <div>
        <p class="eyebrow">PACHINKO LAB / STEP 02</p>
        <h1>ORBIT <span>遊技シミュレーター</span></h1>
      </div>
    </div>
    <div class="session-chip"><span class="status-dot"></span> SESSION ONLY <span class="chip-divider">|</span> <span id="session-chip-data">LIVE DATA</span></div>
  </header>

  <div class="game-layout">
    <aside class="data-sidebar" aria-label="遊技情報">
      <section class="data-panel balance-panel">
        <header class="panel-heading"><div><span class="panel-kicker">PLAY DATA</span><h2>遊技情報</h2></div><span class="sample-tag live-tag">LIVE</span></header>
        <div class="main-balance"><span>現在の持ち玉</span><strong><span id="current-balls">750</span><small>玉</small></strong></div>
        <dl class="money-grid">
          <div><dt>投資額</dt><dd><span id="invested-yen">¥3,000</span></dd></div>
          <div><dt>累計払出</dt><dd><span id="payout-balls">0</span><small>玉</small></dd></div>
          <div><dt>差玉</dt><dd id="difference-balls-cell"><span id="difference-balls">±0</span><small>玉</small></dd></div>
          <div><dt>収支</dt><dd id="balance-yen-cell"><span id="balance-yen">±¥0</span></dd></div>
        </dl>
        <p class="panel-note">持ち玉 = 投資玉 + 払出 − 打ち出し／収支 = 差玉 × 4円</p>
      </section>

      <section class="data-panel session-panel">
        <header class="panel-heading"><div><span class="panel-kicker">SESSION</span><h2>遊技データ</h2></div></header>
        <dl class="stat-grid">
          <div><dt>通常回転数</dt><dd><span id="normal-spins">0</span><small>回</small></dd></div>
          <div><dt>ST回転数</dt><dd><span id="st-spins">0</span><small>回</small></dd></div>
          <div><dt>初当たり</dt><dd><span id="first-hits">0</span><small>回</small></dd></div>
          <div><dt>LUSH突入</dt><dd><span id="lush-entries">0</span><small>回</small></dd></div>
          <div><dt>連チャン</dt><dd><span id="current-streak">0</span><small>回</small></dd></div>
          <div><dt>最高連チャン</dt><dd><span id="max-streak">0</span><small>回</small></dd></div>
          <div class="stat-wide"><dt>累計打ち出し数</dt><dd><span id="launched-balls">0</span><small>玉</small></dd></div>
        </dl>
      </section>

      <section class="data-panel chart-panel" id="balance-chart-panel">
        <header class="panel-heading"><div><span class="panel-kicker">BALANCE</span><h2>収支の推移</h2></div><span class="chart-points" id="balance-chart-points">±¥0</span></header>
        <div class="chart-summary"><strong id="balance-chart-current">±¥0</strong><span>差玉 × 4円</span></div>
        <svg class="balance-chart" viewBox="0 0 220 92" role="img" aria-labelledby="balance-chart-title">
          <title id="balance-chart-title">収支の折れ線グラフ</title>
          <defs>
            <linearGradient id="balance-chart-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#63e9ee" stop-opacity="0.28"></stop>
              <stop offset="100%" stop-color="#63e9ee" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <line class="chart-zero-line" id="balance-chart-zero" x1="6" y1="46" x2="214" y2="46"></line>
          <path class="chart-area" id="balance-chart-area" d=""></path>
          <path class="chart-line" id="balance-chart-line" d=""></path>
          <circle class="chart-dot" id="balance-chart-dot" cx="6" cy="46" r="2.6"></circle>
        </svg>
        <div class="chart-axis"><span>開始</span><span>現在</span></div>
      </section>

      <section class="data-panel history-panel">
        <header class="panel-heading"><div><span class="panel-kicker">HISTORY</span><h2>大当たりデータ</h2></div><span class="history-count" id="jackpot-count">0</span></header>
        <ol class="history-list" id="jackpot-history">
          <li class="history-empty">まだ大当たりはありません</li>
        </ol>
        <p class="panel-note">セッション中に成立した大当たりを新しい順に表示します。</p>
      </section>
    </aside>

    <%= render "board" %>

    <aside class="operation-sidebar" aria-label="操作パネル">
      <section class="operation-panel state-panel">
        <header class="panel-heading"><div><span class="panel-kicker">MACHINE STATUS</span><h2>遊技状態</h2></div></header>
        <div class="machine-state"><i class="state-light"></i><strong>待機中</strong><span>通常状態</span></div>
        <div class="hold-summary"><span>保留</span><div class="hold-lights" aria-label="保留<%= @hold_count %>個"><% 4.times do |index| %><i class="<%= "hold-on" if index < @hold_count %>"></i><% end %></div><small><%= @hold_count %> / 4</small></div>
      </section>

      <section class="operation-panel control-panel">
        <header class="panel-heading"><div><span class="panel-kicker">PLAYER CONTROLS</span><h2>操作パネル</h2></div><span class="sample-tag">接続中</span></header>

        <fieldset class="control-group" aria-describedby="controls-note">
          <legend>打ち出し</legend>
          <div class="strength-buttons">
            <button type="button" class="strength-button left" data-launch-mode="left" aria-pressed="true">左打ち</button>
            <button type="button" class="strength-button right" data-launch-mode="right" aria-pressed="false">右打ち</button>
          </div>
        </fieldset>

        <fieldset class="control-group control-actions" aria-describedby="controls-note">
          <legend>操作</legend>
          <div class="action-buttons">
            <button type="button" class="action-button stop-button" data-simulation-action="stop">■ <span>打ち出し停止</span></button>
            <button type="button" class="action-button" data-simulation-action="pause">Ⅱ <span>一時停止・再開</span></button>
            <button type="button" class="action-button" data-simulation-action="reset">↻ <span>リセット</span></button>
            <button type="button" class="action-button investment-button" data-simulation-action="invest">＋ <span>追加投資</span></button>
          </div>
        </fieldset>
        <p id="controls-note" class="controls-note">自動で玉を発射します。左打ち・右打ちを切り替えられます。ヘソ入賞で抽選し、保留上限は4個です。追加投資は¥1,000（250玉）単位です。</p>

        <details class="physics-calibration">
          <summary>物理検証・入賞率</summary>
          <label for="target-hit-rate">目標入賞率 (%)</label>
          <div class="target-rate-control">
            <input id="target-hit-rate" type="number" min="0" max="100" step="0.1" placeholder="未設定" inputmode="decimal">
            <button id="apply-target-rate" type="button">適用</button>
          </div>
          <p id="target-rate-status" role="status" aria-live="polite">目標値は未設定</p>
          <dl class="physics-stat-grid">
            <div><dt>完了試行</dt><dd id="physics-completed">0</dd></div>
            <div><dt>保留</dt><dd id="physics-pending">0</dd></div>
            <div><dt>ヘソ入賞</dt><dd id="physics-hits">0</dd></div>
            <div><dt>実測率</dt><dd id="physics-rate">—</dd></div>
            <div><dt>目標差</dt><dd id="physics-rate-difference">—</dd></div>
          </dl>
          <div class="strength-trial-stats" aria-label="打ち出し別の試行結果">
            <p>左 <span id="physics-left-stats">0件 / —</span></p>
            <p>右 <span id="physics-right-stats">0件 / —</span></p>
          </div>
          <p class="calibration-note">完了試行は入賞または排出。流下中・取消は実測率の分母に含めません。</p>
        </details>
      </section>
    </aside>
  </div>

  <footer class="simulator-footer">
    <span>ORBIT / ORIGINAL PACHINKO SIMULATOR</span>
    <span>発射・ヘソ入賞・抽選はセッション内で動作します。</span>
  </footer>
</main>
